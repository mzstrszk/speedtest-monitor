{
  "name": "speedtest-monitor",
  "version": "1.0.0",
  "description": "Windows向け通信速度測定Electronアプリケーション",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "test": "jest",
    "lint": "eslint src/",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "author": "SpeedTest Monitor Team",
  "license": "MIT",
  "keywords": [
    "electron",
    "speedtest",
    "network",
    "monitoring",
    "windows"
  ],
  "homepage": "https://github.com/speedtest-monitor/speedtest-monitor",
  "repository": {
    "type": "git",
    "url": "https://github.com/speedtest-monitor/speedtest-monitor.git"
  },
  "dependencies": {
    "electron-log": "^5.0.1",
    "electron-store": "^8.1.0",
    "node-schedule": "^2.1.1",
    "sqlite3": "^5.1.7",
    "universal-speedtest": "^3.0.0"
  },
  "devDependencies": {
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.18.0",
    "globals": "^17.3.0",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.speedtest-monitor.app",
    "productName": "SpeedTest Monitor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icons/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icons/installer-icon.ico",
      "uninstallerIcon": "assets/icons/uninstaller-icon.ico"
    }
  },
  "engines": {
    "node": ">=20.18.1",
    "npm": ">=10.0.0"
  }
}
